# Telegram bot token from @BotFather
TOKEN_API=123456:replace-me

# Google Sheet ID (from its URL) and service-account JSON on one line
GSHEET_KEY_ID=replace-me
GSHEET_CREDENTIALS={"type": "service_account", "project_id": "replace-me"}

# Telegram user IDs allowed to use the bot (also the broadcast recipients)
ALLOWED_USERS=[111111111, 222222222]
# Admins: {"<telegram id>": "<display name>"} — admins are always allowed
ADMIN_USERS={"111111111": "Admin Name"}

# Optional
# WORKSHEET_NAME=Booking_Details
# TIMEZONE=Asia/Singapore
# BOOKING_WINDOW_DAYS=90
# PERSISTENCE_FILE=bot_state.pickle
